{
  "expo": {
    "name": "ثقافتنا",
    "slug": "thaqafatna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "thaqafatna",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0a09"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thaqafatna.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9333ea"
      },
      "package": "com.thaqafatna.app",
      "versionCode": 1,
      "permissions": ["INTERNET", "VIBRATE", "NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "API_BASE_URL": "https://thaqafatna-qr.vercel.app",
      "eas": {
        "projectId": "thaqafatna"
      }
    }
  }
}
