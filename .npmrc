# npm configuration for cross-platform compatibility
# ============================================
# ملاحظة: لا نستخدم omit=optional لأن lightningcss يحتاج optionalDependencies
# لتثبيت linux-x64-gnu binary على Vercel. الحل الصحيح هو عدم ذكر حزم Win32
# كـ direct dependencies (تم إصلاح ذلك في package.json).

# Use legacy peer deps handling (NextAuth v5 beta has React 19 peer dep issues)
legacy-peer-deps=true

# Faster, more reliable registry
registry=https://registry.npmjs.org/

# Don't fail build on platform mismatch for optional deps
fund=false
audit=false
