# =============================================================================
# ثقافتنا — متغيرات البيئة المطلوبة
# Thaqafatna — Required Environment Variables
# =============================================================================
# هذا ملف مرجعي. انسخه إلى .env للتطوير المحلي، أو أضف القيم على Vercel:
# Settings → Environment Variables
#
# ⚠️ تنبيه أمني: لا تُcommit ملف .env الفعلي أبدًا (موجود في .gitignore)

# -----------------------------------------------------------------------------
# 1. قاعدة البيانات (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# من Neon Dashboard → Connection Details → Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"

# Direct (non-pooled) connection — لـ Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. NextAuth (المصادقة)
# -----------------------------------------------------------------------------
# توليد: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_32_BYTE_RANDOM_STRING"

# URL الموقع الكامل — مهم: يجب أن يطابق domain على Vercel تمامًا
AUTH_URL="https://thaqafatna-qr.vercel.app"

# -----------------------------------------------------------------------------
# 3. GitHub OAuth (للدخول الاجتماعي — اختياري لكن مُوصى به)
# -----------------------------------------------------------------------------
# من GitHub → Settings → Developer settings → OAuth Apps
GITHUB_ID="YOUR_GITHUB_OAUTH_APP_ID"
GITHUB_SECRET="YOUR_GITHUB_OAUTH_APP_SECRET"

# -----------------------------------------------------------------------------
# 4. تشفير TOTP (2FA)
# -----------------------------------------------------------------------------
# توليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ يجب أن يبقى نفسه في كل البيئات وإلا تنكسر مفاتيح 2FA
TOTP_ENCRYPTION_KEY="CHANGE_ME_TO_64_HEX_CHARS"

# -----------------------------------------------------------------------------
# 5. Upstash Redis (لـ Rate Limiting)
# -----------------------------------------------------------------------------
# من console.upstash.com → Create Database → REST API section
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# -----------------------------------------------------------------------------
# 6. Vercel Blob (تخزين PDFs + الأغلفة)
# -----------------------------------------------------------------------------
# من Vercel Dashboard → Storage → Create Blob Store → Connect to Project
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXX"

# -----------------------------------------------------------------------------
# 7. إعدادات عامة (اختياري)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ثقافتنا"
NEXT_TELEMETRY_DISABLED="1"
NODE_ENV="production"
